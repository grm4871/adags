# Default: Hermes CLI → Nous Portal. Bills the subscription you already funded.
ADAGS_PROVIDER=hermes
ADAGS_MODEL=nvidia/nemotron-3-super-120b-a12b

# Optional: OpenRouter free if you are not using Portal
# ADAGS_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# ADAGS_MODEL=nvidia/nemotron-3-super-120b-a12b:free

ADAGS_RUN_DIR=run
ADAGS_MAX_TOKENS=1800
ADAGS_CALL_TIMEOUT=60
# Give up if the model only plans, or never speaks. Speech that has started
# still gets the rest of CALL_TIMEOUT. First-token default is 20s — Hermes
# often sits quiet longer than 8s before Nemotron starts.
ADAGS_THINK_TIMEOUT=25
ADAGS_FIRST_TOKEN_TIMEOUT=20

# Periodic Luna clerk brief (not a citizen). Requires `codex` on PATH.
# ADAGS_BRIEF_EVERY=4
# ADAGS_BRIEF_MODEL=gpt-5.6-luna
# ADAGS_BRIEF_EVERY=0   # off
